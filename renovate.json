{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github\\/workflows\\/.*\\.yaml$"],
      "matchStrings": [
        "\\s*# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) versioning=(?<versioning>.*?) registryUrl=(?<registryUrl>.*?)\\s*\\n\\s*.*_VERSION: (?<currentValue>.*)\\s*"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Automerge minor and patch Pleroma updates (merging builds the image; deployment is gated in chroju/infrastructure). Major updates need a human.",
      "matchPackageNames": ["pleroma/pleroma"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Ignore the stray v3.0.0 tag on git.pleroma.social: it was created years ago and is not an actual release.",
      "matchPackageNames": ["pleroma/pleroma"],
      "allowedVersions": "!/^v3\\.0\\.0$/"
    }
  ]
}
