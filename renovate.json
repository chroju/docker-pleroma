{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "prHourlyLimit": 0,
  "customManagers": [
    {
      "customType": "regex",
      "fileMatch": ["^\\.github\\/workflows\\/.*\\.yaml$"],
      "matchStrings": [
        "\\s*# renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?) versioning=(?<versioning>.*?) registryUrl=(?<registryUrl>.*?)\\s*\\n\\s*.*_VERSION: (?<currentValue>.*)\\s*"
      ]
    }
  ],
  "packageRules": [
    {
      "description": "Pleroma のマイナー版・パッチ版の更新は自動でマージする（マージでイメージが作られる。デプロイは infrastructure 側で判断する）。メジャー版は人が確認する",
      "matchPackageNames": ["pleroma/pleroma"],
      "matchUpdateTypes": ["minor", "patch"],
      "automerge": true
    },
    {
      "description": "Pleroma の v3.0.0 タグは公式のリリース一覧になく、依存ライブラリも v2.10 系より古い（現行の Elixir でビルドできない）ため提案させない",
      "matchPackageNames": ["pleroma/pleroma"],
      "allowedVersions": "!/^v3\\.0\\.0$/"
    }
  ]
}
